/*
 * MQTT broker settings. Copy this file to arduino_secrets.h and adjust it;
 * arduino_secrets.h is not tracked by git. Without it the firmware uses
 * test.mosquitto.org:1883 without credentials.
 */
#define SECRET_MQTT_BROKER "test.mosquitto.org"
#define SECRET_MQTT_PORT 1883

// Uncomment both for a broker that requires a login.
// #define SECRET_MQTT_USER "user"
// #define SECRET_MQTT_PASS "password"
